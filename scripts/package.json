{
  "name": "ai-img2sketch-processor",
  "version": "1.0.0",
  "description": "Batch video processor for ai-img2sketch with voice duration detection",
  "type": "module",
  "scripts": {
    "process": "bun run process-videos.ts",
    "process:custom": "bun run process-videos.ts --input",
    "help": "bun run process-videos.ts --help",
    "build:win": "bun build --compile --target=bun-windows-x64 --outfile batch-process.exe process-videos.ts"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
